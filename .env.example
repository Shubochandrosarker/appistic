# Appistic env (VPS deploy)
DATABASE_URL=postgres://appistic_user:replace-with-password@127.0.0.1:5432/appistic_dev
AUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=https://appistic.example.com
NEXT_PUBLIC_SITE_URL=https://appistic.example.com
ADMIN_EMAILS=admin@example.com
PADDLE_API_KEY=replace-with-server-only-paddle-api-key
PADDLE_HOOK_TOKEN=replace-with-random-path-token
PADDLE_PRO_MONTHLY_PRICE_ID=replace-with-paddle-monthly-price-id
PADDLE_PRO_YEARLY_PRICE_ID=replace-with-paddle-yearly-price-id
PADDLE_WEBHOOK_SECRET=replace-with-paddle-notification-secret
MERCHANT_STRIPE_ENABLED=false
